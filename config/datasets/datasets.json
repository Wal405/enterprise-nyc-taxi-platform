{
    "version": 1,
    "datasets": [
        {
            "dataset_id": "yellow_trips",
            "enabled": true,
            "source": {
                "layer": "landing",
                "directory": "nyc_taxi/yellow_trips",
                "file_pattern": "yellow_tripdata_*.parquet",
                "format": "parquet",
                "options": {}
            },
            "target": {
                "layer": "bronze",
                "directory": "yellow_trips"
            },
            "ingestion": {
                "mode": "incremental",
                "strategy": "file_based"
            }
        },
        {
            "dataset_id": "taxi_zones",
            "enabled": true,
            "source": {
                "layer": "landing",
                "directory": "nyc_taxi/taxi_zones",
                "file_pattern": "taxi_zone_lookup.csv",
                "format": "csv",
                "options": {
                    "header": "true",
                    "delimiter": ","
                }
            },
            "target": {
                "layer": "bronze",
                "directory": "taxi_zones"
            },
            "ingestion": {
                "mode": "full",
                "strategy": "reference_snapshot"
            }
        }
    ]
}
