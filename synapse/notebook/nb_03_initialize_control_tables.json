		"cells": [
			{
				"cell_type": "code",
				"source": [
					"config_uri = \"abfss://config@stnyctaxidev001.dfs.core.windows.net/environments/dev.json\""
				],
				"execution_count": 45
			},
			{
				"cell_type": "code",
				"source": [
					"config = load_config(config_uri)\n",
					"\n",
					"manifest_path = build_storage_path(\n",
					"    config,\n",
					"    \"monitoring\",\n",
					"    config[\"paths\"][\"monitoring\"][\"ingestion_manifest\"]\n",
					")\n",
					"\n",
					"schema_path = build_storage_path(\n",
					"    config,\n",
					"    \"config\",\n",
					"    config[\"paths\"][\"config\"][\"manifest_schema\"]\n",
					")\n",
					"\n",
					"manifest_schema = StructType.fromJson(load_config(schema_path))"
				],
				"execution_count": 46
			},
			{
				"cell_type": "code",
				"source": [
					"from delta.tables import DeltaTable\n",
					"\n",
					"if not DeltaTable.isDeltaTable(spark, manifest_path):\n",
					"    (\n",
					"        spark.createDataFrame([], manifest_schema)\n",
					"        .write\n",
					"        .format(\"delta\")\n",
					"        .mode(\"errorifexists\")\n",
					"        .save(manifest_path)\n",
					"    )"
				],
				"execution_count": 47
			},
			{
				"cell_type": "code",
				"source": [
					"manifest_df = spark.read.format(\"delta\").load(manifest_path)\n",
					"\n",
					"manifest_df.printSchema()\n",
					"\n",
					"print(\"Total records:\", manifest_df.count())"
				],
				"execution_count": 48
			}
		]
	}
